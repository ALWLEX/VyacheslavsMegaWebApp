[
  {
    "outputFileName": "wwwroot/css/style.min.css",
    "inputFiles": [
      "wwwroot/css/base/normalize.css",
      "wwwroot/css/base/variables.css",
      "wwwroot/css/base/fonts.css",
      "wwwroot/css/base/layout.css",

      "wwwroot/css/components/*",
      "wwwroot/css/components/form/*",
      "wwwroot/css/pages/*"
    ],
    "minify": {
      "enabled": true,
      "renameLocals": true,
      "cssComment": "none", // удаляем все комментарии
      "colorNames": "hex", // цвета в шестнадцатеричный формат
      "minifyExpressions": true, // минификация выражений
      "termSemicolons": true, // удаляем лишние точки с запятой
      "outputMode": "singleLine" // одна строка
    },
    "sourceMap": true
  }
]
