@model EmailConfirmationViewModel

<div class="block block--first block--account">
    <div class="container">
        <div class="section section--centered">
            <h2 class="section__title section__title--main">Подтверждение email</h2>

            <p>На вашу электронную почту было отправлено письмо с кодом, введите его в поле ниже. Провертье папку спам, письмо с кодом может по ошибке попасть туда.</p>

            <form class="form account-form form--text-left" asp-area="" asp-controller="Account" asp-action="ConfirmEmail" method="post">
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label" asp-for="ConfirmationCode"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="ConfirmationCode">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Подтвердить</span>
                    </button>
                    <p id="resend-code">
                        Новый код можно будет запросить повторно через
                        <span id="resend-timer">03:00</span>
                    </p>
                </div>
            </form>

            <input type="hidden"
                   id="code-sent-at"
                   value="@(Model.User.EmailConfirmedCodeCreationTime?.ToString("yyyy-MM-ddTHH:mm:ssZ") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))">

        </div>
    </div>
</div>

<script src="~/js/new-code-timer.js"></script>