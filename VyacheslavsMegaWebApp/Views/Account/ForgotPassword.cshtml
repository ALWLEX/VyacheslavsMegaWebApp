@model ForgotPasswordViewModel

<div class="block block--first block--account">
    <div class="container">
        <div class="section section--centered">
            <h2 class="section__title section__title--main">Сброс пароля</h2>

            <p>На вашу электронную почту будет отправлена ссылка для сброса пароля. Введите данные аккаунта для продолжения.</p>

            <form class="form account-form form--text-left" asp-area="" asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label" asp-for="UserInput"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="UserInput">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Подтвердить</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>