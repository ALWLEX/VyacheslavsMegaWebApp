@model DonationPageViewModel

<div class="block block--first block--donation-intro">
    <div class="container">
        <div class="section section--centered">
            <h1 class="section__title section__title--main">Пожертвования</h1>
            @if (Model.HasCards)
            {
                <p>Пожертвовать на развитие проекта можно по номеру карты:</p>
                <div class="cards-container donation-intro__cards-container">
                    @foreach (DonationCard card in Model.DonationCards)
                    {
                        <div class="card" style="background: linear-gradient(45deg, @card.ColorDownLeft, @card.ColorUpRight);">
                            <div class="card__header">
                                <span>@card.BankName</span>
                            </div>
                            <div class="card__body">
                                <p class="card__number">@card.CardNumber</p>
                                <a href="#" class="card__copy-link" onclick="copyCardNumber(event, @card.CardNumderNormalized)">Скопировать номер</a>
                            </div>
                            <div class="card__footer">
                                <span>@card.CardHolder</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <p>Если вы сюда попали рекомендуется прочитать <a href="#attention">этот раздел</a></p>
        </div>
    </div>
</div>

<div class="block block--donation-fund">
    <div class="container">
        <div class="section section--centered">
            <h2 class="section__title">Состояние фонда сервера</h2>

            <p>Текущая цель - @Model.Goal.Name</p>
            <p>Денег собрано:</p>
            
            <div class="mc-bar donation-fund__bar">
                <div class="mc-bar__text" id="xpText">0/100</div>
                <div class="mc-bar__progress" id="xpBar"></div>

                <input id="fundCurrent" type="hidden" value="@Model.FundAmount" />
                <input id="goalPrice" type="hidden" value="@Model.Goal.Price" />
            </div>

            <p class="section_text font_size_normal">Последние транзакции:</p>
            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Сумма</td>
                        <td>Назначение</td>
                        <td>Доп. информация</td>
                    </tr>

                    @if (Model.LastTransactions.Count == 0)
                    {
                        <tr class="mc-table--center-aligment">
                            <td colspan="3">Транзакций пока не было</td>
                        </tr>
                    }
                    else
                    {
                        foreach (FundTransaction transaction in Model.LastTransactions)
                        {
                            <tr>
                                <td>@transaction.Amount</td>
                                <td>@transaction.Purpose.Name</td>
                                <td>@transaction.Note</td>
                            </tr>
                        }
                        <tr class="mc-table--center-aligment">
                            <td colspan="3"><a asp-controller="Home" asp-action="TransactionsHistory">Остальные транзакции</a></td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<div class="block block--donation-attention" id="attention">
    <div class="container">
        <div class="section">
            <h2 class="section__title">Внимание!</h2>
            <p>Прочитайте этот раздел, здесь могут быть ответы на ваши вопросы</p>
            <ul>
                <li>У проекта пока нет конкретной цели - просто развиваемся как по кайфу.</li>
                <li>Проект является некоммерческим, не приносит прибыли создателю и не обещает никаких выгод или
                    привилегий от пожертвований.</li>
                <li>Пожертвования тратятся на содержание проекта и рекламные расходы.</li>
                <li>Помимо денег можно жертвовать предметы и/или своё время. Для подробностей свяжитесь с
                    создателем
                    проекта в разделе <a href="/#contacts">контактов</a>.</li>
                <li>Возможно позже сделаю топ донатеров.</li>
                <li>Не "DonationAlerts" или другая платформа - по причине того, что там жадные капиталисты берут
                    комиссию, наживаясь на работягах.</li>
            </ul>
        </div>
    </div>
</div>

<script src="~/js/donation-progress.js"></script>
<script src="~/js/copy-card-number.js"></script>