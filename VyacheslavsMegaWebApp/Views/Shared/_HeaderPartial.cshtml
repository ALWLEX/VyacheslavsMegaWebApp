@using Microsoft.AspNetCore.Identity
@using VyacheslavsMegaWebApp.Data.Entities.Identity
@using VyacheslavsMegaWebApp.Data.Repositories
@inject UserManager<VmsIdentityUser> _userManager;

@{
    VmsIdentityUser? user = await _userManager.GetUserAsync(User);
    bool isAdmin = user is null ? false : await _userManager.IsInRoleAsync(user, "Admin");
}

<div class="header">
    <div class="container">
        <div class="header__inner">
            <a class="header__logo-link" href="/">
                <div class="logo">
                    <img class="logo__image" src="~/img/logo.svg" />
                    <span class="logo__text">МЕГА СЕРВЕР<br>ВЯЧЕСЛАВА</span>
                </div>
            </a>
        
            <nav class="header__menu">
                <a class="header__menu-link" href="/">Главная</a>
                <a class="header__menu-link" asp-area="" asp-controller="Home" asp-action="DonationPage">Пожертвования</a>
                <a class="header__menu-link" asp-area="" asp-controller="UserReports" asp-action="New">Сообщить о неисправности</a>
                <a class="header__menu-link" href="/#contacts">Контакты</a>
            </nav>

            <div class="header__user">
            @if (user is null)
            {
                <a class="header__menu-link header__menu-link--account" asp-area="" asp-controller="Account" asp-action="Login">Вход</a>
            }
            else
            {
                <div class="dropdown">
                    @if (!user.EmailConfirmed)
                    {
                        <span class="warning-blink">⚠️</span>
                    }     
                    <a class="header__menu-link header__menu-link--account dropdown__content">@user.UserName</a>
                    <div class="dropdown__menu">
                        <table class="header__table-menu">
                            @if (!user.EmailConfirmed)
                            {
                                <tr>
                                    <td><span class="warning-blink">⚠️</span></td>
                                        <td class="dropdown__menu-link"><a class="header__menu-link" asp-area="" asp-controller="Account" asp-action="SendEmailConfirmationToken">Подтвердите e-mail</a></td>
                                </tr>
                            }
                            <tr> 
                                <td></td>
                                    <td class="dropdown__menu-link"><a class="header__menu-link" asp-area="" asp-controller="Account" asp-action="AccountSettings">Настройки профиля</a></td>
                            </tr>
                            @if (isAdmin)
                            {
                                <tr>
                                    <td></td>
                                    <td class ="dropdown__menu-link"><a class="header__menu-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Панель администратора</a></td>
                                </tr>
                            }
                            <tr>
                                <td></td>
                                <td class="dropdown__menu-link"><a class="header__menu-link" asp-area="" asp-controller="Account" asp-action="Logout">Выйти</a></td>
                            </tr>
                        </table>
                    </div>
                </div>
            }
            </div>

            <div class="header__burger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
</div>