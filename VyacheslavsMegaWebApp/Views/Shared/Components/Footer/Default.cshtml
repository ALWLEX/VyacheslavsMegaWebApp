@model FooterViewModel

<div class="footer">
    <div class="container">
        <div class="footer__container">
            <div class="footer__author-info">
                <h3 class="footer__header">Создатель сервера</h3>
                <p>
                    Сервер является некоммерческим проектом компании "Vyacheslav's engineering company" под
                    руководством Вячеслава
                </p>
            </div>
            <div class="footer__server--status">
                <h3 class="footer__header">Состояние сервера</h3>
                @if (!Model.MCServerStat.Available)
                {
                    <p>Состояние сервера сейчас неизвестно</p>
                }
                else
                {
                    @if (Model.MCServerStat.IsOnline)
                    {
                        <p>
                            Сервер онлайн!
                            <img class="footer__server-status-icon" src="~/img/serverStatusIcons/OnlineIcon.png">
                        </p>
                        <p>Игроков на сервере: @Model.MCServerStat.Players.Online/@Model.MCServerStat.Players.Max</p>
                    }
                    else
                    {
                        <p>
                            Сервер оффлайн!
                            <img class="footer__server-status-icon" src="~/img/serverStatusIcons/OfflineIcon.png">
                        </p>
                        <p>Игроков на сервере: 0</p>
                    }
                }
                
            </div>
            <div class="footer__project-media">
                <h3 class="footer__header">Соц. сети проекта</h3>
                <div class="footer__media-links">
                    @foreach (ServerMediaLink link in Model.ServerMediaLinks.Where(l => l.ShowLink))
                    {
                        <p class="iconed-link">
                            <img class="iconed-link__icon" src="~/@link.LogoFullPath" />
                            <a href="@link.Url">@link.Content</a>
                        </p>
                    }
                </div>
            </div>
            <div class="footer__center-row">
                <p>У тебя всё ещё какие-то проблемы? Обратись в раздел <a href="/#contacts">контактов</a></p>
            </div>
            <div class="footer__bottom">
                <p>Vyacheslav's engineering company, г. Костанай</p>
            </div>
        </div>
    </div>
</div>