@model TransactionPurposesIndexViewModel

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Назначения транзакций</h2>

            @if (TempData["RemoveError"] is string errorMessage)
            {
                <div class="error-box">
                    @errorMessage
                </div>
            }
            
            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Id</td>
                        <td>Назначение</td>
                        <td>Тип</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach (TransactionPurpose purpose in Model.TransactionPurposes)
                    {
                        <tr>
                            <td>@purpose.Id</td>
                            <td>@purpose.Name</td>
                            <td>@purpose.GetTypeText()</td>
                            <td><a asp-action="TransactionPurposeDetails" asp-route-purposeId="@purpose.Id">Редактировать</a></td>
                            <td><a asp-action="RemoveTransactionPurpose" asp-route-purposeId="@purpose.Id" onclick="confirmRemove(event)">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="5"><a asp-action="TransactionPurposeDetails">Добавить назначение транзакции</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>