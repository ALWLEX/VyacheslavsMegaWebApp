@model FundManagementViewModel

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Управление фондом</h2>
            
            <div class="form-container">
                <form class="form" asp-area="Admin" asp-controller="FundManagement" asp-action="Index" method="post">
                    <div class="form">
                        <div class="form__body">

                            <div class="form__validation-summary" asp-validation-summary="All"></div> 

                            <div class="form__row">
                                <div class="form-group">
                                    <label class="form-group__label" asp-for="DateStart"></label>
                                    <div class="form-group__control">
                                        <div class="field">
                                            <input class="field__input" type="date" asp-for="DateStart" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-group__label" asp-for="DateEnd"></label>
                                    <div class="form-group__control">
                                        <div class="field">
                                            <input class="field__input" type="date" asp-for="DateEnd" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="form-group__label" asp-for="CountTransactions"></label>
                                <div class="form-group__control">
                                    <div class="field">
                                        <input class="field__input" type="number" step="5" asp-for="CountTransactions" />
                                    </div>
                                </div>
                            </div>

                            <div class="form__row">
                                <div class="form-group">
                                    <div class="form-group__control">
                                        <label class="mc-radio">
                                            <input class="mc-radio__input" type="radio" asp-for="Filter" value="@FundManagementViewModel.FilterBy.DATE">
                                            <span class="mc-radio__circle"></span>
                                            <span class="mc-radio__label">По дате</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group__control">
                                        <label class="mc-radio">
                                            <input class="mc-radio__input" type="radio" asp-for="Filter" value="@FundManagementViewModel.FilterBy.LAST">
                                            <span class="mc-radio__circle"></span>
                                            <span class="mc-radio__label">Последние</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                        </div>
                    
                        <div class="form__footer">
                            <button class="mc-button mc-button--wide" type="submit">
                                <span class="mc-button__title">Выбрать</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Сумма</td>
                        <td>Дата</td>
                        <td>От кого/куда</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach(FundTransaction transaction in Model.FundTransactions)
                    {
                    <tr>
                        <td>@transaction.Amount</td>
                        <td>@transaction.Date</td>
                        <td>@transaction.Purpose.Name</td>
                        <td><a asp-action="TransactionDetails" asp-route-transactionId="@transaction.Id">Редактировать</a></td>
                        <td><a asp-action="RemoveTransaction" asp-route-transactionId="@transaction.Id" onclick="confirmRemove(event)">Удалить</a></td>
                    </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="6"><a asp-action="TransactionDetails">Добавить транзакцию</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>