@model MainPageData

<script type="text/javascript" src="~/js/trix-min.js"></script>

<div class="block block--first">
    <div class="container">
        <div class="form-container">
            <form class="form" asp-area="Admin" asp-controller="MainPageEditor" asp-action="EditMainPage">

                <div class="form__header">
                    <h2 class="form__title form__title--main">Содержание главной страницы</h2>
                </div>

                <input type="hidden" asp-for="Id" readonly />

                <div class="form__body">

                    <div class="form__validation-summary" asp-validation-summary="All"></div>

                    <!-- Title -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="Title"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Title">
                            </div>
                        </div>
                    </div>

                    <!-- YellowHint -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="YellowHint"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="YellowHint">
                            </div>
                        </div>
                    </div>

                    <!-- ErrorMessage -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="ErrorMessage"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="ErrorMessage">
                            </div>
                        </div>
                    </div>

                    <!-- ShowErrorMessage -->
                    <div class="form-group">
                        <div class="form-group__control">
                            <label class="mc-checkbox">
                                <input class="mc-checkbox__input" asp-for="ShowErrorMessage">
                                <span class="mc-checkbox__box"></span>
                                <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.ShowErrorMessage)</span>
                            </label>
                        </div>
                    </div>

                    <!-- ServerAddress -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="ServerAddress"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="ServerAddress">
                            </div>
                        </div>
                    </div>

                    <!-- ServerVersion -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="ServerVersion"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="ServerVersion">
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="Description"></label>
                        <trix-editor input="trix_input">@Html.Raw(Model.Description)</trix-editor>
                        <input type="hidden" asp-for="Description" id="trix_input" />
                    </div>

                    <!-- Meta -->
                    <div class="form-group">
                        <label class="form-group__label" asp-for="PageTitle"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="PageTitle">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="MetatagDescription"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="MetatagDescription">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="MetatagKeywords"></label>
                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="MetatagKeywords">
                            </div>
                        </div>
                    </div>

                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сохранить</span>
                    </button>

                    <p><a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a></p>
                </div>
            </form>
        </div>
    </div>
</div>