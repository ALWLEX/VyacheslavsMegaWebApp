@model DonationCardsEditorViewModel

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Редактор карт</h2>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Название карты</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach (DonationCard card in Model.DonationCards)
                    {
                        <tr>
                            <td>@card.CardName</td>
                            <td><a asp-action="CardDetails" asp-route-cardId="@card.Id">Редактировать</a></td>
                            <td><a asp-action="RemoveCard" asp-route-cardId="@card.Id" onclick="confirmRemove(event)">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="3"><a asp-action="CardDetails">Добавить карту</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>