@model GoalManagementViewModel

<link rel="stylesheet" href="~/css/components/mc-table.css" />
<link rel="stylesheet" href="~/css/components/mc-checkbox.css" />
<link rel="stylesheet" href="~/css/pages/admin.css" />

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h1 class="section__title section__title--main">Управление целями</h1>

            <div class="table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Название</td>
                        <td>Цена</td>
                        <td>Текущая</td>
                        <td>Выполнена</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach (Goal goal in Model.Goals)
                    {
                        <tr>
                            <td>@goal.Name</td>
                            <td>@goal.Price</td>
                            <td class="mc-table--center-aligment">
                                <label class="mc-checkbox">
                                    <input class="mc-checkbox__input" type="checkbox" checked="@goal.IsCurrent" disabled/>
                                    <span class="mc-checkbox__box"></span>
                                </label>
                            </td>
                            <td class="mc-table--center-aligment">
                                <label class="mc-checkbox">
                                    <input class="mc-checkbox__input" type="checkbox" checked="@goal.IsCompleted" disabled/>
                                    <span class="mc-checkbox__box"></span>
                                </label>
                            </td>
                            <td><a asp-action="GoalDetails" asp-route-goalId="@goal.Id">Редактировать</a></td>
                            <td><a asp-action="RemoveGoal" asp-route-goalId="@goal.Id">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="6"><a asp-action="GoalDetails">Добавить цель</a></td>
                    </tr>
                </table>
            </div>
            
            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>