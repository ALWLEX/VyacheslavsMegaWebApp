@model PartnersEditorViewModel

<link rel="stylesheet" href="~/css/components/mc-table.css" />
<link rel="stylesheet" href="~/css/pages/admin.css" />

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Редактор партнёров</h2>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Партнёр</td>
                        <td colspan="3">Действия</td>
                    </tr>
                    @foreach (Partner partner in Model.Partners)
                    {
                        <tr>
                            <td>@partner.Name</td>
                            <td><a asp-action="PartnerDetails" asp-route-partnerId="@partner.Id">Редактировать</a></td>
                            <td><a asp-action="PartnerLinks" asp-route-partnerId="@partner.Id">Редактировать ссылки</a></td>
                            <td><a asp-action="RemovePartner" asp-route-partnerId="@partner.Id" onclick="confirmRemove(event)">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="4"><a asp-action="PartnerDetails">Добавить партнёра</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>

<script src="~/js/navigation-confirmation.js"></script>