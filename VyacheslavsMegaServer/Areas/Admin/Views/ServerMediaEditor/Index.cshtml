@model LinksEditorViewModel<ServerMediaLink>

<div class="block block--first">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Редактор соц. сетей сервера</h2>

            <div class="mc-table-container">
                <table class="mc-table mc-table--wide">
                    <tr class="mc-table--center-aligment">
                        <td>Иконка</td>
                        <td>URL</td>
                        <td>Отображаемое значение</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach (ServerMediaLink link in Model.Links)
                    {
                        <tr>
                            <td><img class="mc-table__img" src="~/@link.LogoFullPath" /></td>
                            <td>@link.Url</td>
                            <td>@link.Content</td>
                            <td><a asp-action="LinkDetails" asp-route-linkId="@link.Id">Редактировать</a></td>
                            <td><a asp-action="RemoveLink" asp-route-linkId="@link.Id">Удалить</a></td>
                        </tr>
                    }
                    <tr class="mc-table--center-aligment">
                        <td colspan="5"><a asp-action="LinkDetails">Добавить ссылку</a></td>
                    </tr>
                </table>
            </div>

            <p class="back-link">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">Назад</a>
            </p>
        </div>
    </div>
</div>