@model LinksEditorViewModel<ServerMediaLink>

<div class="block_big_first">
    <div class="container">
        <div class="intro_container">
            <h1 class="title">Редактор соц. сетей сервера</h1>
            <br />
            <div class="table_container">
                <table class="mc_form_font_standart white mc_table wide_element">
                    <tr class="tr_header">
                        <td>Иконка</td>
                        <td>URL</td>
                        <td>Отображаемое значение</td>
                        <td colspan="2">Действия</td>
                    </tr>
                    @foreach (ServerMediaLink link in Model.Links)
                    {
                        <tr>
                            <td class="align_center"><img class="link_icon" src="~/@link.LogoFullPath" /></td>
                            <td class="align_left">@link.Url</td>
                            <td class="align_left">@link.Content</td>
                            <td><a asp-action="LinkDetails" asp-route-linkId="@link.Id">Редактировать</a></td>
                            <td><a asp-action="RemoveLink" asp-route-linkId="@link.Id">Удалить</a></td>
                        </tr>
                    }
                    <tr class="tr_header">
                        <td colspan="5"><a asp-action="LinkDetails">Добавить ссылку</a></td>
                    </tr>
                </table>
            </div>
            <div class="form_next_block">
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="white mc_form_font_standart">Назад</a>
            </div>
        </div>
    </div>
</div>