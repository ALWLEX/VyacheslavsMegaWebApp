@model MainPageViewModel

<div class="intro" id="intro">
    <div class="container">

        <div class="intro__container">
            <div class="intro__title-container">
                <style>
                    .intro__title::after {
                        content: "@Html.Raw(Model.MainPageData.YellowHint)";
                    }
                </style>
                <h1 class="intro__title">@Html.Raw(@Model.MainPageData.Title)</h1>
            </div>

            <div class="intro__info-container">
                <div class="intro__info-block intro__info-block--shrink">
                    <h3 class="intro__info-title">Состояние сервера</h3>

                    @if (Model.MainPageData.ShowErrorMessage)
                    {
                        <p class="intro__info-text intro__info-text--error">@Model.MainPageData.ErrorMessage</p>
                    }
                    <p class="intro__info-text">IP: @Model.MainPageData.ServerAddress</p>
                    <p class="intro__info-text">Версия: 1.21.11</p>
                    <p class="intro__info-text">Игроков онлайн: 09/11</p>
                </div>

                <div class="intro__info-block">
                    <h3 class="intro__info-title">Полезные ресурсы</h3>
                    @if (Model.MainPageData.ShowDownloadButton)
                    {
                        @if (Model.MainPageData.DownloadLocalResource)
                        {
                            <a href="~/@Model.MainPageData.DownloadButtonUrl">
                                <button class="mc-button mc-button--wide" type="button">
                                    <span class="mc-button__title">@Model.MainPageData.DownloadButtonTitle</span>
                                </button>
                            </a>
                        }
                        else
                        {
                            <a href="@Model.MainPageData.DownloadButtonUrl">
                                <button class="mc-button mc-button--wide" type="button">
                                    <span class="mc-button__title">@Model.MainPageData.DownloadButtonTitle</span>
                                </button>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@if (Model.MediaLinks.Any(l => l.ShowLink))
{
    <div class="block-stripe">
        @foreach (ServerMediaLink link in Model.MediaLinks.Where(l => l.ShowLink))
        {
        <div class="iconed-link">
            @if (link.HasLogo)
            {
                <img class="iconed-link__icon" src="~/@link.LogoFullPath" />
            }
            <a href="@link.Url">@link.Content</a>
        </div>
        }
    </div>
}

<div class="block block--about" id="about">
    <div class="container">
        <div class="section">
            <h2 class="section__title">О проекте</h2>
            <p>
                @Html.Raw(Model.MainPageData.Description)
            </p>
            <p>
                Присоединяйтесь к нам по адресу @Model.MainPageData.ServerAddress и станьте частью нашего мира!
            </p>
        </div>
    </div>
</div>

<div class="block block--contacts" id="contacts">
    <div class="container">
        <div class="section">
            <h2 class="section__title">Контакты</h2>
            <div class="contact">
                <img class="contact__image" src="~/img/Evray.png" />
                <div>
                    <p>Вячеслав (Evray), создатель и администратор сервера</p>
                    <ul>
                        @foreach (ContactLink link in Model.Creator.Links)
                        {
                            <li>@link.Description<a class="white" href="@Html.Raw(link.Url)">@link.Content</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.PartnersData.Any(p => p.ShowPartner))
{
    <div class="block block--partners">
        <div class="container">
            <div class="section">
                <h2 class="section__title">Наши партнёры</h2>
                <div class="horizontal-scroller horizontal-scroller--index">
                    <div class="horizontal-scroller__arrow-container horizontal-scroller__arrow-container--start"
                    id="HScrollerToStart">
                        <div class="horizontal-scroller__arrow-left"></div>
                        <div class="horizontal-scroller__arrow-left"></div>
                    </div>
                    <div class="horizontal-scroller__arrow-container horizontal-scroller__arrow-container--prev"
                    id="HScrollerPrev">
                        <div class="horizontal-scroller__arrow-left"></div>
                    </div>

                    <div class="horizontal-scroller__content" id="HScrollerContent">

                        @foreach (Partner partner in Model.PartnersData.Where(p => p.ShowPartner))
                        {
                            <div class="partner-card">
                                <img class="partner-card__logo" src="~/@partner.LogoFullPath" />
                                <span class="partner-card__line"></span>
                                <div class="partner-card__text-container">

                                    <h3 class="partner-card__title">@partner.Name</h3>
                                    <p class="partner-card__subtitle">@partner.Subtitle</p>
                                    <p class="partner-card__text">@partner.Description</p>

                                    @if (partner.Links.Any())
                                    {
                                        <p class="partner-card__text">Контакты партнёра:</p>
                                        <ul>
                                            @foreach (PartnerLink link in partner.Links)
                                            {
                                                <li>@link.Description<a class="white" href="@Html.Raw(link.Url)">@link.Content</a></li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="horizontal-scroller__arrow-container horizontal-scroller__arrow-container--next"
                    id="HScrollerNext">
                        <div class="horizontal-scroller__arrow-right"></div>
                    </div>
                    <div class="horizontal-scroller__arrow-container horizontal-scroller__arrow-container--end"
                    id="HScrollerToEnd">
                        <div class="horizontal-scroller__arrow-right"></div>
                        <div class="horizontal-scroller__arrow-right"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/js/horizontalScroller.js"></script>