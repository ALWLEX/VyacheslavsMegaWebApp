@model UserReport

<link rel="stylesheet" href="~/css/pages/report.css" />
<link rel="stylesheet" href="~/css/components/form.css" />
<link rel="stylesheet" href="~/css/components/mc-button.css" />

<div class="block block--report">
    <div class="container">
        <div class="section section--first">
            <h2 class="section__title">Не работает сервер? Сообщите о сбоях:</h2>

            <div class="form-container">
                <form class="form" method="post" asp-action="New">

                    <div class="form__body">

                        <div class="form__validation-summary" asp-validation-summary="All"></div>

                        <div class="form-group">
                            <label class="form-group__label" asp-for="Subject"></label>

                            <div class="form-group__control">
                                <div class="field">
                                    <input class="field__input" asp-for="Subject">
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-group__label" asp-for="ReportText"></label>

                            <div class="form-group__control">
                                <div class="field">
                                    <textarea class="field__input field__input--no-resize" placeholder="Введите минимум 5 символов" rows="8"
                                              asp-for="ReportText" id="reportText"></textarea>
                                </div>
                            </div>

                            <div class="form-group__hint" id="counter">
                                (<span id="current">0</span>&nbsp;/
                                <span>500</span> символов)
                            </div>

                        </div>
                    </div>

                    <div class="form__footer">
                        <button class="mc-button mc-button--wide" type="submit">
                            <span class="mc-button__title">Сохранить</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/report-text-counter.js"></script>