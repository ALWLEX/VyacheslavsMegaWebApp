@model RegisterViewModel

<link rel="stylesheet" href="~/css/pages/account.css" />
<link rel="stylesheet" href="~/css/components/form.css" />
<link rel="stylesheet" href="~/css/components/mc-button.css" />

<div class="block block--first block--account">
    <div class="container">
        <div class="section">
            <h2 class="section__title section__title--main">Регистрация</h2>

            <form class="form account-form" asp-area="" asp-controller="Account" asp-action="Register" method="post">
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label" asp-for="UserName"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="UserName">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Email"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Email">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Password"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="Password">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="PasswordConfirm"></label>

                        <div class="form-group__control">
                            <div class="field">
                                <input class="field__input" asp-for="PasswordConfirm">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Регистрация</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>