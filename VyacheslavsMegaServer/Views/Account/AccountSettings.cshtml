@model ChangePasswordViewModel

<link rel="stylesheet" href="~/css/pages/account.css" />
<link rel="stylesheet" href="~/css/components/form.css" />
<link rel="stylesheet" href="~/css/components/mc-button.css" />

<div class="block block--account">
    <div class="container">
        <div class="section section--first">
            <h2 class="section__title section__title--main">Настройки аккаунта</h2>

            <form class="form account-form" asp-area="" asp-controller="Account" asp-action="ChangePassword" method="post">
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label" asp-for="OldPassword"></label>

                        <div class="form-group__control">
                            <div class="field field_type_text">
                                <input class="field__input" asp-for="OldPassword">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="NewPassword"></label>

                        <div class="form-group__control">
                            <div class="field field_type_text">
                                <input class="field__input" asp-for="NewPassword">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="ConfirmPassword"></label>

                        <div class="form-group__control">
                            <div class="field field_type_text">
                                <input class="field__input" asp-for="ConfirmPassword">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Сменить пароль</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>