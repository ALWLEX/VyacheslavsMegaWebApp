@model LoginViewModel

<link rel="stylesheet" href="~/css/pages/account.css" />
<link rel="stylesheet" href="~/css/components/form.css" />
<link rel="stylesheet" href="~/css/components/mc-checkbox.css" />
<link rel="stylesheet" href="~/css/components/mc-button.css" />

<div class="block block--account">
    <div class="container">
        <div class="section section--first">
            <h2 class="section__title section__title--main">Вход</h2>

            <form class="form account-form" asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
                <div class="form__validation-summary" asp-validation-summary="All"></div>

                <div class="form__body">
                    <div class="form-group">
                        <label class="form-group__label" asp-for="UserName"></label>

                        <div class="form-group__control">
                            <div class="field field_type_text">
                                <input class="field__input" asp-for="UserName">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-group__label" asp-for="Password"></label>

                        <div class="form-group__control">
                            <div class="field field_type_text">
                                <input class="field__input" asp-for="Password">
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-group__control">
                            <label class="mc-checkbox">
                                <input class="mc-checkbox__input" asp-for="RememberMe">
                                <span class="mc-checkbox__box"></span>
                                <span class="mc-checkbox__label">@Html.DisplayNameFor(x => x.RememberMe)</span>
                            </label>
                        </div>
                    </div>
                    
                </div>

                <div class="form__footer">
                    <button class="mc-button mc-button--wide" type="submit">
                        <span class="mc-button__title">Войти</span>
                    </button>
                    <p class="mc_form_font_standart white">Нет аккаунта? А как насчёт <a asp-area="" asp-controller="Account" asp-action="Register">зарегестрировать</a>?</p>
                </div>
            </form>
        </div>
    </div>
</div>