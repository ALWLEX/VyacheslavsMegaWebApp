@model ErrorViewModel

<link rel="stylesheet" href="~/css/pages/status-code-page.css" />

<div class="status-code-block">
    <div class="container status-code-block__container">
        <div class="status-code-block__section">
            @if(Model.CurrentPageType == ErrorViewModel.PageType.StatusCode)
            {
                <style>
                    .status-code-block__title::after {
                        content: "@Html.Raw(Model.StatusMessage)";
                    }
                </style>
                <h1 class="status-code-block__title">Ой, ошибка @Model.StatusCode<br>пришла</h1>
            }   
            else
            {
                <h1 class="status-code-block__title">Ошибка</h1>
                <p>Возникла ошибка в процессе запроса</p>

                @if (Model.ShowRequestId)
                {
                    <p>
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }
            }
            <p><a href="/">Вернуться на главную старницу</a></p>
        </div>
    </div>
</div>